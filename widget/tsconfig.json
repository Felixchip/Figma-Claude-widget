{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react",
    "jsxFactory": "figma.widget.h",
    "jsxFragmentFactory": "figma.widget.Fragment",
    "strict": true,
    "outDir": "dist",
    "lib": ["ES2019"],
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@figma"]
  },
  "include": ["code.tsx"]
}